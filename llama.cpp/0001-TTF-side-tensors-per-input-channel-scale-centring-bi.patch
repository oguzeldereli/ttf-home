index 68c9e606c..76b8dd7e5 100644
--- a/src/llama-graph.cpp
+++ b/src/llama-graph.cpp
@@ -1060,6 +1060,7 @@ llm_graph_context::llm_graph_context(const llm_graph_params & params) :
     backend_cpu      (params.backend_cpu),
     cvec             (params.cvec),
     loras            (params.loras),
+    ttf              (params.ttf),
     mctx             (params.mctx),
     cross            (params.cross),
     samplers         (params.samplers),
@@ -1082,11 +1083,46 @@ ggml_tensor * llm_graph_context::build_cvec(
     return cvec->apply_to(ctx0, cur, il);
 }
 
+ggml_tensor * llm_graph_context::build_ttf_mm(
+          ggml_tensor * w,
+          ggml_tensor * cur,
+  const llama_ttf_lin & l) const {
+    if (l.c) {
+        cur = ggml_mul(ctx0, cur, l.c);
+    }
+    if (l.m) {
+        cur = ggml_add(ctx0, cur, l.m);
+    }
+    ggml_tensor * res = ggml_mul_mat(ctx0, w, cur);
+    if (l.b) {
+        res = ggml_add(ctx0, res, l.b);
+    }
+    return res;
+}
+
 ggml_tensor * llm_graph_context::build_lora_mm(
           ggml_tensor * w,
           ggml_tensor * cur,
           ggml_tensor * w_s) const {
-    ggml_tensor * res = ggml_mul_mat(ctx0, w, cur);
+    ggml_tensor * res = nullptr;
+
+    const llama_ttf_ext * te = nullptr;
+    if (ttf && !ttf->empty()) {
+        auto it = ttf->find(w);
+        if (it != ttf->end()) {
+            te = &it->second;
+        }
+    }
+
+    if (te) {
+        res = build_ttf_mm(w, cur, te->main);
+        if (te->d && te->u) {
+            ggml_tensor * h = build_ttf_mm(te->d, cur, te->dl);
+            res = ggml_add(ctx0, res, build_ttf_mm(te->u, h, te->ul));
+        }
+    } else {
+        res = ggml_mul_mat(ctx0, w, cur);
+    }
 
     if (w_s) {
         res = ggml_mul(ctx0, res, w_s);
