diff --git a/src/llama-model.cpp b/src/llama-model.cpp
index d041a9ce3..7225d57bb 100644
--- a/src/llama-model.cpp
+++ b/src/llama-model.cpp
@@ -1467,6 +1467,82 @@ bool llama_model_base::load_tensors(llama_model_loader & ml) {
             }
         }
     }
+    // TTF side tensors: optional, next to the weight they belong to (see llama-ttf.h)
+    {
+        const auto tn = LLM_TN(arch);
+        auto ttf_vec = [&](llm_tensor e, const char * suf, int bid, int64_t n) -> ggml_tensor * {
+            const std::string name = tn(e, suf, bid);
+            const ggml_tensor * meta = ml.get_tensor_meta(name.c_str());
+            if (!meta) {
+                return nullptr;
+            }
+            if (ggml_n_dims(meta) != 1 || meta->ne[0] != n) {
+                throw std::runtime_error(format("TTF tensor %s: expected [%lld]", name.c_str(), (long long) n));
+            }
+            return create_tensor(tn(e, suf, bid), {n}, TENSOR_NOT_REQUIRED);
+        };
+        auto ttf_mat = [&](llm_tensor e, const char * suf, int bid, int64_t K, int64_t N) -> ggml_tensor * {
+            const std::string name = tn(e, suf, bid);
+            const ggml_tensor * meta = ml.get_tensor_meta(name.c_str());
+            if (!meta) {
+                return nullptr;
+            }
+            // K or N may be the adapter rank (-1: take it from the file)
+            const int64_t k = K < 0 ? meta->ne[0] : K;
+            const int64_t n = N < 0 ? meta->ne[1] : N;
+            return create_tensor(tn(e, suf, bid), {k, n}, TENSOR_NOT_REQUIRED);
+        };
+        auto ttf_load = [&](llm_tensor e, ggml_tensor * w, int bid) {
+            if (!w || ggml_n_dims(w) != 2) {
+                return;
+            }
+            const int64_t K = w->ne[0];
+            const int64_t N = w->ne[1];
+            llama_ttf_ext te;
+            te.main.c = ttf_vec(e, "ttf_c", bid, K);
+            te.main.m = ttf_vec(e, "ttf_m", bid, K);
+            te.main.b = ttf_vec(e, "ttf_b", bid, N);
+            te.d = ttf_mat(e, "ttf_d", bid, K, -1);
+            if (te.d) {
+                const int64_t r = te.d->ne[1];
+                te.dl.c = ttf_vec(e, "ttf_d_c", bid, K);
+                te.dl.m = ttf_vec(e, "ttf_d_m", bid, K);
+                te.dl.b = ttf_vec(e, "ttf_d_b", bid, r);
+                te.u = ttf_mat(e, "ttf_u", bid, r, N);
+                if (!te.u) {
+                    throw std::runtime_error(format("TTF adapter %s has a down layer but no up layer", tn(e, "ttf_d", bid).str().c_str()));
+                }
+                te.ul.c = ttf_vec(e, "ttf_u_c", bid, r);
+                te.ul.m = ttf_vec(e, "ttf_u_m", bid, r);
+                te.ul.b = ttf_vec(e, "ttf_u_b", bid, N);
+            }
+            if (te.main.c || te.main.m || te.main.b || te.d) {
+                ttf[w] = te;
+            }
+        };
+        {
+            for (int i = 0; i < n_layer_all; ++i) {
+                auto & layer = layers[i];
+                ttf_load(LLM_TENSOR_ATTN_Q,     layer.wq,        i);
+                ttf_load(LLM_TENSOR_ATTN_K,     layer.wk,        i);
+                ttf_load(LLM_TENSOR_ATTN_V,     layer.wv,        i);
+                ttf_load(LLM_TENSOR_ATTN_OUT,   layer.wo,        i);
+                ttf_load(LLM_TENSOR_ATTN_QKV,   layer.wqkv,      i);
+                ttf_load(LLM_TENSOR_ATTN_GATE,  layer.wqkv_gate, i);
+                ttf_load(LLM_TENSOR_FFN_GATE,   layer.ffn_gate,  i);
+                ttf_load(LLM_TENSOR_FFN_DOWN,   layer.ffn_down,  i);
+                ttf_load(LLM_TENSOR_FFN_UP,     layer.ffn_up,    i);
+                ttf_load(LLM_TENSOR_SSM_IN,     layer.ssm_in,    i);
+                ttf_load(LLM_TENSOR_SSM_OUT,    layer.ssm_out,   i);
+                ttf_load(LLM_TENSOR_SSM_ALPHA,  layer.ssm_alpha, i);
+                ttf_load(LLM_TENSOR_SSM_BETA,   layer.ssm_beta,  i);
+            }
+            if (!ttf.empty()) {
+                LLAMA_LOG_INFO("%s: TTF side tensors on %zu weights\n", __func__, ttf.size());
+            }
+        }
+    }
+
     ml.done_getting_tensors();
 
     // Tied NVFP4 output is valid when no separate LM-head scale tensors are present.
