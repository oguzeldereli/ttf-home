diff --git a/src/llama-ttf.h b/src/llama-ttf.h
new file mode 100644
index 000000000..04a955d2b
--- /dev/null
+++ b/src/llama-ttf.h
@@ -0,0 +1,27 @@
+#pragma once
+
+// TTF (ternary) layers: y = mul_mat(W, c * x + m) + b  [+ the low-rank ternary adapter U (D x)], where
+// W holds the trits with the row scale folded into its block scales (TQ1_0 / TQ2_0 / Q2_K hold {-1, 0, 1} * d
+// exactly), c is the per-input-channel scale, m = -c * mu the centring, b the output bias. Each of the three
+// parts is optional; the adapter's down (D) and up (U) layers have the same form. The side tensors sit next to
+// the weight in the GGUF: <base>.ttf_c / ttf_m / ttf_b, <base>.ttf_d (+ _c / _m / _b), <base>.ttf_u (+ _c / _m / _b).
+
+#include "ggml.h"
+
+#include <unordered_map>
+
+struct llama_ttf_lin {
+    ggml_tensor * c = nullptr; // [K] column scale
+    ggml_tensor * m = nullptr; // [K] -c * mu (centring)
+    ggml_tensor * b = nullptr; // [N] bias
+};
+
+struct llama_ttf_ext {
+    llama_ttf_lin main;
+    ggml_tensor * d = nullptr; // [K, r] adapter down
+    llama_ttf_lin dl;
+    ggml_tensor * u = nullptr; // [r, N] adapter up
+    llama_ttf_lin ul;
+};
+
+using llama_ttf_map = std::unordered_map<const ggml_tensor *, llama_ttf_ext>;
