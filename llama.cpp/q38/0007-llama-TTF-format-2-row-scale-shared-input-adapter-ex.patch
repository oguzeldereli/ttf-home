@@ -1788,12 +1808,63 @@ llm_graph_amax_src1 llm_graph_context::build_amax_src1_f16(
     return result;
 }
 
+// TTF expert product: per expert e (ids), y = r_e * (W_e (c_e * x + m_e)) + au_e (ad_e (c_e * x + m_e)) + b_e.
+// The per-expert side vectors [n, E] are gathered by the flattened ids: [n, n_used * n_tokens] -> [n, n_used, n_tokens].
+ggml_tensor * llm_graph_context::build_ttf_mm_id(
+          ggml_tensor * w,
+          ggml_tensor * cur,
+          ggml_tensor * ids,
+          ggml_tensor * slots,
+  const llama_ttf_ext & te) const {
+    const int64_t n_used   = ids->ne[0];
+    const int64_t n_tokens = ids->ne[1];
+    ggml_tensor * ids_flat = nullptr;
+    auto sel = [&](ggml_tensor * v) -> ggml_tensor * {
+        if (ids_flat == nullptr) {
+            ids_flat = ggml_reshape_1d(ctx0, ggml_cont(ctx0, ids), n_used * n_tokens);
+        }
+        return ggml_reshape_3d(ctx0, ggml_get_rows(ctx0, v, ids_flat), v->ne[0], n_used, n_tokens);
+    };
+    ggml_tensor * xc = cur; // [K, 1 or n_used, n_tokens]
+    if (te.main.c) {
+        xc = ggml_mul(ctx0, sel(te.main.c), xc);
+    }
+    if (te.main.m) {
+        xc = ggml_add(ctx0, xc, sel(te.main.m));
+    }
+    ggml_tensor * res = slots == nullptr ?
+        ggml_mul_mat_id(ctx0, w, xc, ids) :
+        ggml_mul_mat_id(ctx0, moe_cache->get_experts(w), xc, slots);
+    if (te.main.r) {
+        res = ggml_mul(ctx0, res, sel(te.main.r));
+    }
+    if (te.ad && te.au) {
+        ggml_tensor * h = ggml_mul_mat_id(ctx0, te.ad, xc, ids);         // [R, n_used, n_tokens]
+        res = ggml_add(ctx0, res, ggml_mul_mat_id(ctx0, te.au, h, ids));
+    }
+    if (te.main.b) {
+        res = ggml_add(ctx0, res, sel(te.main.b));
+    }
+    return res;
+}
+
 ggml_tensor * llm_graph_context::build_lora_mm_id(
           ggml_tensor * w,   // ggml_tensor * as
           ggml_tensor * cur, // ggml_tensor * b
           ggml_tensor * ids,
           ggml_tensor * w_s,
           ggml_tensor * slots) const {
+    const llama_ttf_ext * te = nullptr;
+    if (ttf && !ttf->empty()) {
+        auto it = ttf->find(w);
+        if (it != ttf->end()) {
+            te = &it->second;
+        }
+    }
+    if (te) {
+        return build_ttf_mm_id(w, cur, ids, slots, *te);
+    }
+
     // as in build_lora_mm: the folded weight reads the transformed input, the LoRA delta reads `cur`
     ggml_tensor * cur_mm = build_hadamard_input(w, cur);
     // the experts in the MoE cache are selected by their slots
