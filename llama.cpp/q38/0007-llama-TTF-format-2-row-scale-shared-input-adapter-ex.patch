 src/llama-graph.h          |  7 ++++
 src/llama-model-loader.cpp |  9 ++++
 src/llama-model.cpp        | 34 ++++++++++++++-
 src/llama-model.h          |  2 +
 src/llama-ttf.h            |  8 ++++
 src/models/qwen4exp.cpp    | 84 ++++++++++++++++++++++++++++++++++++--
 7 files changed, 210 insertions(+), 7 deletions(-)

