+class TQ1_P(__Quant, qtype=GGMLQuantizationType.TQ1_P):
+    # TTF: 160 trits in 32 bytes, no block scale (the input holds trits; the row scale is a side tensor).
+    # Element 32 n + b = base-3 digit n (n = 0 most significant) of byte b.
+    @classmethod
+    def quantize_blocks(cls, blocks: np.ndarray) -> np.ndarray:
+        n_blocks = blocks.shape[0]
+        qs = (np.clip(np_roundf(blocks), -1, 1).astype(np.int8) + np.int8(1)).astype(np.uint16)
+        qs = qs.reshape((n_blocks, 5, 32)) * np.array([81, 27, 9, 3, 1], dtype=np.uint16).reshape((1, 5, 1))
+        qs = np.sum(qs, axis=-2)
+        return ((qs * 256 + (243 - 1)) // 243).astype(np.uint8)
+
+    @classmethod
+    def dequantize_blocks(cls, blocks: np.ndarray) -> np.ndarray:
+        n_blocks = blocks.shape[0]
+        qs = blocks.reshape((n_blocks, 1, 32)) * np.array([1, 3, 9, 27, 81], dtype=np.uint8).reshape((1, 5, 1))
+        qs = ((qs.astype(np.uint16) * 3) >> 8).astype(np.int8) - np.int8(1)
+        return qs.reshape((n_blocks, 160)).astype(np.float32)
+
