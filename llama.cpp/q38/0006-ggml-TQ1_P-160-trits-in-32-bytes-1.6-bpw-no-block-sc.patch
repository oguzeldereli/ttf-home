     yy[i*QK_K + e] = __half2float(x[i].d) * ((int) ((q * 3) >> 8) - 1);
 }
 
+template<typename dst_t>
+static __global__ void dequantize_block_tq1_p(const void * __restrict__ vx, dst_t * __restrict__ yy) {
+
+    const int64_t i = blockIdx.x;
+    const block_tq1_p * x = (const block_tq1_p *) vx;
+    const int e = threadIdx.x;     // the element, 0..159: digit e / 32 of byte e % 32
+    const uint32_t pow3[5] = {1, 3, 9, 27, 81};
+    const uint32_t q = ((uint32_t) x[i].qs[e % 32] * pow3[e / 32]) & 0xFF;
+    yy[i*QK_TQ1_P + e] = (float) ((int) ((q * 3) >> 8) - 1);
+}
+
+template<typename dst_t>
+static void dequantize_row_tq1_p_cuda(const void * vx, dst_t * y, const int64_t k, cudaStream_t stream) {
+    const int nb = k / QK_TQ1_P;
+    dequantize_block_tq1_p<<<nb, QK_TQ1_P, 0, stream>>>(vx, y);
+}
