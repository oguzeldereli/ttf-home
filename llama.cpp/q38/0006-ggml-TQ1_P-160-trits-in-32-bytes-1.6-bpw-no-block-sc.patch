diff --git a/ggml/src/ggml-common.h b/ggml/src/ggml-common.h
index 1dbbe326d..6adf48d11 100644
--- a/ggml/src/ggml-common.h
+++ b/ggml/src/ggml-common.h
@@ -278,6 +278,15 @@ typedef struct {
     uint8_t qh[QK_K/64]; // 4 elements per byte
     ggml_half d;
 } block_tq1_0;
+
+// 1.6 bpw: 160 trits in 32 bytes, five per byte, no block scale (TTF: the row scale is a side tensor). Element 32*n + b
+// is digit n (n = 0 most significant) of byte b; digit n of byte q is ((uint8_t) (q * 3^n) * 3) >> 8, in {0, 1, 2} =
+// trit + 1 (the TQ1_0 code). Digit plane n lines up with the n-th Q8_0 / Q8_1 block of 32 activations.
+#define QK_TQ1_P 160
+typedef struct {
+    uint8_t qs[QK_TQ1_P/5];
+} block_tq1_p;
+static_assert(sizeof(block_tq1_p) == 32, "wrong tq1_p block size/padding");
 static_assert(sizeof(block_tq1_0) == sizeof(ggml_half) + QK_K / 64 + (QK_K - 4 * QK_K / 64) / 5, "wrong tq1_0 block size/padding");
 
 // 2.0625 bpw
