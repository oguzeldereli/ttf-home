+// TQ1_P: 160 trits in 32 bytes, digit n of byte b -> element 32n + b, so digit plane n is q8_1 block n of the five
+// under the TQ1_P block. One int (4 bytes) of codes per thread, iqs 0..7; no block scale (the row scale is applied in
+// the graph).
+#define VDR_TQ1_P_Q8_1_MMVQ 1
+
+static __device__ __forceinline__ float vec_dot_tq1_p_q8_1(
+    const void * __restrict__ vbq, const block_q8_1 * __restrict__ bq8_1, const int & kbx, const int & iqs) {
+
+    const block_tq1_p * bq = (const block_tq1_p *) vbq + kbx;
+    const int v = get_int_b4(bq->qs, iqs);
+
+    float sumf = 0.0f;
