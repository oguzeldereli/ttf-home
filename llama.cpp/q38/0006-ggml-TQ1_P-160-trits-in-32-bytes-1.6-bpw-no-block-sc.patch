 void quantize_row_tq1_0(const float * GGML_RESTRICT x, void * GGML_RESTRICT vy, int64_t k) {
     assert(k % QK_K == 0);
     block_tq1_0 * GGML_RESTRICT y = vy;
@@ -526,6 +530,64 @@ void ggml_vec_dot_q8_0_q8_0_generic(int n, float * GGML_RESTRICT s, size_t bs, c
     *s = sumf;
 }
 
+// TQ1_P x Q8_0: digit plane n of TQ1_P block i against Q8_0 block 5 i + n; no block scale on the TQ1_P side (the row
+// scale is applied in the graph), so the result is sum_n d_y(5 i + n) * sum_m trit * q8
+void ggml_vec_dot_tq1_p_q8_0(int n, float * GGML_RESTRICT s, size_t bs, const void * GGML_RESTRICT vx, size_t bx, const void * GGML_RESTRICT vy, size_t by, int nrc) {
+    assert(nrc == 1);
+    UNUSED(nrc);
+    UNUSED(bx);
+    UNUSED(by);
+    UNUSED(bs);
+    assert(n % QK_TQ1_P == 0);
+
+    const block_tq1_p * GGML_RESTRICT x = vx;
+    const block_q8_0  * GGML_RESTRICT y = vy;
+    const int nb = n / QK_TQ1_P;
+
+#if defined(__AVX2__)
+    __m256 acc = _mm256_setzero_ps();
+    const __m256i one8  = _mm256_set1_epi8(1);
+    const __m256i one16 = _mm256_set1_epi16(1);
+    for (int i = 0; i < nb; ++i) {
+        __m256i q[5];
+        q[0] = _mm256_loadu_si256((const __m256i *) x[i].qs);
+        q[1] = _mm256_add_epi8(q[0], _mm256_add_epi8(q[0], q[0]));                                     // 1 * 3
+        q[2] = _mm256_add_epi8(_mm256_and_si256(_mm256_slli_epi16(q[0], 3), _mm256_set1_epi8(-8)), q[0]); // 1 * 9
+        q[3] = _mm256_add_epi8(_mm256_and_si256(_mm256_slli_epi16(q[1], 3), _mm256_set1_epi8(-8)), q[1]); // 3 * 9
+        q[4] = _mm256_add_epi8(_mm256_and_si256(_mm256_slli_epi16(q[2], 3), _mm256_set1_epi8(-8)), q[2]); // 9 * 9
+        for (int j = 0; j < 5; ++j) {
+            // digit = (q * 3) >> 8 via halving adds (as tq1_0), then trit = digit - 1
+            __m256i t = _mm256_subs_epu8(q[j], one8);
+            t = _mm256_avg_epu8(t, _mm256_avg_epu8(t, _mm256_setzero_si256()));
+            t = _mm256_and_si256(_mm256_srli_epi16(t, 6), _mm256_set1_epi8(3));
+            t = _mm256_sub_epi8(t, one8);
+            const __m256i qy = _mm256_loadu_si256((const __m256i *) y[5*i + j].qs);
+            const __m256i p  = _mm256_madd_epi16(_mm256_maddubs_epi16(one8, _mm256_sign_epi8(qy, t)), one16);
+            acc = _mm256_fmadd_ps(_mm256_set1_ps(GGML_CPU_FP16_TO_FP32(y[5*i + j].d)), _mm256_cvtepi32_ps(p), acc);
+        }
+    }
+    __m128 r = _mm_add_ps(_mm256_castps256_ps128(acc), _mm256_extractf128_ps(acc, 1));
+    r = _mm_add_ps(r, _mm_movehl_ps(r, r));
+    r = _mm_add_ss(r, _mm_movehdup_ps(r));
+    *s = _mm_cvtss_f32(r);
+#else
+    static const uint8_t pow3[5] = {1, 3, 9, 27, 81};
+    float sumf = 0.0f;
+    for (int i = 0; i < nb; ++i) {
+        for (int j = 0; j < 5; ++j) {
+            int sumi = 0;
+            for (int m = 0; m < 32; ++m) {
+                const uint8_t q = (uint8_t) (x[i].qs[m] * pow3[j]);
+                const int d = ((uint16_t) q * 3) >> 8;
+                sumi += (d - 1) * y[5*i + j].qs[m];
+            }
+            sumf += GGML_CPU_FP16_TO_FP32(y[5*i + j].d) * (float) sumi;
+        }
+    }
+    *s = sumf;
+#endif
+}
