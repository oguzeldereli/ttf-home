+// TQ1_P -> Q8_0 (d = 1): the batched TQ1_P expert products use the Q8_0 MMQ kernels (ggml-cuda.cu)
+void ggml_cuda_tq1_p_to_q4_0(const void * vx, void * vy, int64_t k, cudaStream_t stream);
diff --git a/ggml/src/ggml-cuda/ggml-cuda.cu b/ggml/src/ggml-cuda/ggml-cuda.cu
index cc3dde044..77f0fb0ad 100644
--- a/ggml/src/ggml-cuda/ggml-cuda.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda.cu
@@ -2315,6 +2315,40 @@ static void ggml_cuda_mul_mat(ggml_backend_cuda_context & ctx, const ggml_tensor
     ggml_cuda_mul_mat_cublas(ctx, src0, src1, dst);
 }
 
+// TQ1_P has no MMQ tile (its 160-value blocks do not divide MMQ_ITER_K): batched expert products expand the trits to
+// Q4_0 (d = 1, nibble = v + 8: the same values) in a pool buffer and use the Q4_0 MMQ kernels. Without this the
+// batched TQ1_P MUL_MAT_ID took the per-expert fallback (host sync, dequantise + cuBLAS per expert). Q4_0 rather than
+// Q8_0: the expand writes 4.5 instead of 8.5 bits per weight (Q38 prefill pp2048 705 -> 787 tok/s); the zero padding
+// has d = 0, so it reads as 0.
+static bool ggml_cuda_tq1_p_via_q4_0(const ggml_tensor * src0, const int cc, const int64_t ne12) {
+    return src0->type == GGML_TYPE_TQ1_P && ggml_is_contiguous(src0) && src0->ne[0] % QK4_0 == 0 &&
+        ggml_cuda_should_use_mmq(GGML_TYPE_Q4_0, cc, ne12, /*n_experts=*/src0->ne[2]);
+}
+
+static void ggml_cuda_mul_mat_id_tq1_p_q4_0(ggml_backend_cuda_context & ctx, const ggml_tensor * src0,
+                                           const ggml_tensor * src1, const ggml_tensor * ids, ggml_tensor * dst) {
+    cudaStream_t stream = ctx.stream();
+    const int64_t n      = ggml_nelements(src0);
+    const size_t  size   = (size_t) (n / QK4_0) * sizeof(block_q4_0);
+    // MMQ may read up to MATRIX_ROW_PADDING values past the last row (y is zero there): keep that tail finite
+    const size_t  pad    = (size_t) (MATRIX_ROW_PADDING / QK4_0) * sizeof(block_q4_0);
+    ggml_cuda_pool_alloc<char> q4(ctx.pool(), size + pad);
+    CUDA_CHECK(cudaMemsetAsync(q4.get() + size, 0, pad, stream));
+    ggml_cuda_tq1_p_to_q4_0(src0->data, q4.get(), n, stream);
+
+    ggml_tensor x = *src0;
+    x.type  = GGML_TYPE_Q4_0;
+    x.data  = q4.get();
+    x.nb[0] = sizeof(block_q4_0);
+    x.nb[1] = x.nb[0] * (x.ne[0] / QK4_0);
+    for (int i = 2; i < GGML_MAX_DIMS; ++i) {
+        x.nb[i] = x.nb[i - 1] * x.ne[i - 1];
+    }
+    x.buffer   = nullptr;   // (a pool buffer, already padded and cleared above)
+    x.view_src = nullptr;
+    ggml_cuda_mul_mat_q(ctx, &x, src1, ids, dst);
+}
+
