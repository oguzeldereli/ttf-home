 // [TAG_MUL_MAT_ID_CUDA_GRAPHS]
 static bool ggml_cuda_mul_mat_id_needs_sync(const ggml_tensor * dst, const int cc) {
@@ -2341,6 +2375,10 @@ static bool ggml_cuda_mul_mat_id_needs_sync(const ggml_tensor * dst, const int c
         return false;
     }
 
+    if (ggml_cuda_tq1_p_via_q4_0(src0, cc, src1->ne[2])) {
+        return false;
+    }
+
     if (ggml_cuda_should_use_mmf(src0->type, cc, warp_size, src0->ne, src0->nb, src1->ne[2], /*mul_mat_id=*/true)) {
         return false;
     }
@@ -2384,6 +2422,11 @@ static void ggml_cuda_mul_mat_id(ggml_backend_cuda_context & ctx, ggml_tensor *
             return;
         }
 
+        if (ggml_cuda_tq1_p_via_q4_0(src0, cc, ne12)) {
+            ggml_cuda_mul_mat_id_tq1_p_q4_0(ctx, src0, src1, ids, dst);
+            return;
+        }
+
         if (ggml_cuda_should_use_mmf(src0->type, cc, warp_size, src0->ne, src0->nb, src1->ne[2], /*mul_mat_id=*/true)) {
             ggml_cuda_mul_mat_f(ctx, src0, src1, ids, dst);
             return;
