-const char * const LLM_FFN_EXPS_REGEX = "\\.ffn_(up|down|gate|gate_up)_(ch|)exps";
+// TTF: the per-expert side vectors (.ttf_c/.ttf_m/.ttf_r/.ttf_b, ~10 MB per layer) stay with the compute: on the CPU
+// their GET_ROWS + the elementwise ops on [n_ff, n_tokens*top_k] split the graph (prefill 240 -> 705 tok/s on Q38)
+const char * const LLM_FFN_EXPS_REGEX = "\\.ffn_(up|down|gate|gate_up)_(ch|)exps(?!\\.ttf_[cmrb])";
 
 const char * const LLM_FFN_DENSE_REGEX = "\\.ffn_(up|down|gate)\\.";
 
diff --git a/ggml/src/ggml-cuda/convert.cu b/ggml/src/ggml-cuda/convert.cu
index 1af0598cc..9df982782 100644
--- a/ggml/src/ggml-cuda/convert.cu
+++ b/ggml/src/ggml-cuda/convert.cu
@@ -338,6 +338,38 @@ static void dequantize_row_tq1_p_cuda(const void * vx, dst_t * y, const int64_t
     dequantize_block_tq1_p<<<nb, QK_TQ1_P, 0, stream>>>(vx, y);
 }
 
+// TQ1_P -> Q4_0 with d = 1 (nibble = v + 8: the same values) for the MMQ expert path. Digit plane n of a TQ1_P block
+// (elements 32 n .. 32 n + 31 = digit n of bytes 0..31) is Q4_0 block 5 i + n; one thread per output qs byte.
+static __global__ void tq1_p_to_q4_0_kernel(const block_tq1_p * __restrict__ x, block_q4_0 * __restrict__ y, const int64_t n_out) {
+    const int64_t t = (int64_t) blockIdx.x * blockDim.x + threadIdx.x;
+    if (t >= n_out) {
+        return;
+    }
+    const int64_t i = t / (5*QK4_0/2);
+    const int     r = t % (5*QK4_0/2);
+    const int     n = r / (QK4_0/2);
+    const int     j = r % (QK4_0/2);
+    const uint32_t pow3[5] = {1, 3, 9, 27, 81};
+    const uint32_t ql = ((uint32_t) x[i].qs[j]           * pow3[n]) & 0xFF;
+    const uint32_t qh = ((uint32_t) x[i].qs[j + QK4_0/2] * pow3[n]) & 0xFF;
+    // digit = v + 1 in {0, 1, 2}; nibble = v + 8 = digit + 7
+    block_q4_0 & o = y[5*i + n];
+    o.qs[j] = (uint8_t) ((((ql * 3) >> 8) + 7) | ((((qh * 3) >> 8) + 7) << 4));
+    if (j == 0) {
+        o.d = __float2half(1.0f);
+    }
+}
+
+void ggml_cuda_tq1_p_to_q4_0(const void * vx, void * vy, const int64_t k, cudaStream_t stream) {
+    static_assert(QK_TQ1_P == 5*QK4_0, "TQ1_P block = 5 Q4_0 blocks");
+    const int64_t nb    = k / QK_TQ1_P;
+    const int64_t n_out = nb * (5*QK4_0/2);
+    if (n_out > 0) {
+        const int threads = 256;
+        tq1_p_to_q4_0_kernel<<<(n_out + threads - 1) / threads, threads, 0, stream>>>((const block_tq1_p *) vx, (block_q4_0 *) vy, n_out);
+    }
+}
+
 template<typename dst_t>
 static void dequantize_row_tq1_0_cuda(const void * vx, dst_t * y, const int64_t k, cudaStream_t stream) {
     const int nb = k / QK_K;
