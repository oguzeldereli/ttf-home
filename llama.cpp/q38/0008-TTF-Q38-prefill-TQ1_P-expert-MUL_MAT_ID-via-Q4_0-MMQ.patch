 ggml/src/ggml-cuda/convert.cu   | 32 ++++++++++++++++++++++++
 ggml/src/ggml-cuda/convert.cuh  |  3 +++
 ggml/src/ggml-cuda/ggml-cuda.cu | 43 +++++++++++++++++++++++++++++++++
 ggml/src/ggml-cuda/mmq.cu       |  2 +-
 5 files changed, 82 insertions(+), 2 deletions(-)

