 ggml/src/ggml-cuda/common.cuh   |  7 +++++++
 ggml/src/ggml-cuda/convert.cu   | 30 +++++++++++++++++++++++++++
 ggml/src/ggml-cuda/ggml-cuda.cu |  1 +
 ggml/src/ggml-cuda/mmvq.cu      |  8 ++++++++
 ggml/src/ggml-cuda/vecdotq.cuh  | 36 +++++++++++++++++++++++++++++++++
 5 files changed, 82 insertions(+)

