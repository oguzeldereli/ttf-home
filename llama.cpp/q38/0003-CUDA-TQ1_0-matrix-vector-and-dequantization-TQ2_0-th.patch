diff --git a/ggml/src/ggml-cuda/vecdotq.cuh b/ggml/src/ggml-cuda/vecdotq.cuh
index 162127bd5..0fafb0a4c 100644
--- a/ggml/src/ggml-cuda/vecdotq.cuh
+++ b/ggml/src/ggml-cuda/vecdotq.cuh
@@ -949,6 +949,42 @@ static __device__ __forceinline__ float vec_dot_tq2_0_q8_1(
     return __half2float(bq->d) * sumf;
 }
 
+// TQ1_0: five base-3 digits per byte (qh: four), digit n of byte b = ((b * 3^n mod 256) * 3) >> 8, in {0, 1, 2}.
+// Element order: qs[0..31] digit n -> elements 32n + byte (q8_1 blocks 0..4); qs[32..47] digit n -> 160 + 16n + byte
+// (half blocks of 5..7); qh[0..3] digit n -> 240 + 4n + byte (the second half of block 7). One int of codes per
+// thread, iqs 0..12 (iqs 13..15 idle).
+#define VDR_TQ1_0_Q8_1_MMVQ 1
+
+// digit n (p = 3^n) of the 4 bytes of v, two bytes per 16-bit lane (b * 81 < 2^16: no carry between lanes)
+static __device__ __forceinline__ int tq1_0_digit4(const int v, const uint32_t p) {
+    const uint32_t e = (( (uint32_t) v       & 0x00FF00FF) * p) & 0x00FF00FF;
+    const uint32_t o = ((((uint32_t) v >> 8) & 0x00FF00FF) * p) & 0x00FF00FF;
+    return (int) ((((e * 3) >> 8) & 0x00030003) | ((((o * 3) >> 8) & 0x00030003) << 8));
+}
+
+static __device__ __forceinline__ float vec_dot_tq1_0_q8_1(
+    const void * __restrict__ vbq, const block_q8_1 * __restrict__ bq8_1, const int & kbx, const int & iqs) {
+
+    if (iqs >= 13) {
+        return 0.0f;
+    }
+    const block_tq1_0 * bq = (const block_tq1_0 *) vbq + kbx;
+    const int v = get_int_b2(bq->qs, iqs);          // iqs 12: qh, which follows qs
+
+    // the q8_1 block and int of digit n, without branches (a warp holds all three cases)
+    const bool lo = iqs < 8, hi = iqs == 12;
+    float sumf = 0.0f;
+    uint32_t p = 1;
+#pragma unroll
+    for (int n = 0; n < 5; ++n, p *= 3) {
+        const int blk = lo ? n : (hi ? 7 : 5 + n/2);
+        const int idx = lo ? iqs : (hi ? 4 + n : (n % 2)*4 + iqs - 8);
+        const int u   = (hi && n == 4) ? 0 : get_int_b4(bq8_1[blk].qs, idx);
+        sumf += __low2float(bq8_1[blk].ds) * (ggml_cuda_dp4a(tq1_0_digit4(v, p), u, 0) - ggml_cuda_dp4a(0x01010101, u, 0));
+    }
+    return __half2float(bq->d) * sumf;
+}
+
