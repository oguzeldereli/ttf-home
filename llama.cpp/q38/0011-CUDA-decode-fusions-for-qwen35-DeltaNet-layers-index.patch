+// true when every compute node that reads one of mids (directly or through any view) is in inside[]
+static bool ggml_cuda_only_inside_readers(const ggml_cgraph * cgraph, const ggml_tensor * const * mids, int nm,
+                                          const ggml_tensor * const * inside, int ni) {
+    const ggml_tensor * roots[8];
+    int nr = 0;
+    GGML_ASSERT(nm <= 8);
+    for (int m = 0; m < nm; ++m) {
+        const ggml_tensor * r = ggml_cuda_root(mids[m]);
+        if (std::find(roots, roots + nr, r) == roots + nr) {
+            roots[nr++] = r;
+        }
+    }
+    int total = 0;
+    for (int m = 0; m < nr; ++m) {
+        total += ggml_cuda_reader_count(cgraph, roots[m]);
+    }
+    int internal = 0;
+    const ggml_tensor * r[GGML_MAX_SRC];
+    for (int i = 0; i < ni; ++i) {
+        if (!inside[i] || ggml_cuda_is_view_or_noop(inside[i]) || std::find(inside, inside + i, inside[i]) != inside + i) {
+            continue;
+        }
+        const int k = ggml_cuda_distinct_roots(inside[i], r);
+        for (int j = 0; j < k; ++j) {
+            internal += std::find(roots, roots + nr, r[j]) != roots + nr;
+        }
+    }
+    return total == internal;
+}
