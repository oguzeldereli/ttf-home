+static const ggml_tensor * ggml_cuda_other_src(const ggml_tensor * n, const ggml_tensor * prev) {
+    if (ggml_cuda_strip_views(n->src[0]) == prev) {
+        return n->src[1];
+    }
+    if (ggml_cuda_strip_views(n->src[1]) == prev) {
+        return n->src[0];
+    }
+    return nullptr;
+}
+
+static bool ggml_cuda_gdn_gates_vec(const ggml_tensor * t, int64_t H) {
+    return t && t->type == GGML_TYPE_F32 && ggml_nelements(t) == H && ggml_is_contiguous(t);
+}
+
+static bool ggml_cuda_gdn_gates_w(const ggml_tensor * w, int64_t K, int64_t H) {
+    return w->type == GGML_TYPE_F16 && w->ne[0] == K && w->ne[1] == H && w->ne[2] == 1 && w->ne[3] == 1 &&
+           w->nb[0] == sizeof(half) && w->nb[1] % 16 == 0 && ((uintptr_t) w->data) % 16 == 0;
+}
+
+static bool ggml_cuda_gdn_gates_disabled() {
+    static const bool d = ggml_cuda_env_flag("GGML_CUDA_DISABLE_GDN_GATES");
+    return d;
