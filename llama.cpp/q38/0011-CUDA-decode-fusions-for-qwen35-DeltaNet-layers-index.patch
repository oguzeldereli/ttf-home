+        }
+    }
+    g.q_raw    = (const float *) raw[0]->data;
+    g.k_raw    = (const float *) raw[1]->data;
+    g.sq1      = raw[0]->nb[1] / sizeof(float);
+    g.sq2      = raw[0]->nb[2] / sizeof(float);
+    g.sq3      = raw[0]->nb[3] / sizeof(float);
+    g.l2_eps   = eps[0];
+    g.l2_scale = sc[0];
+    return true;
+}
