+
+// one gate chain from the MUL_MAT at j: MUL_MAT(W, x) [ADD bias] SIGMOID (beta) or MUL_MAT(W, x) ADD dt SOFTPLUS MUL a
+// (gate); reshapes / views between are skipped
+struct ggml_cuda_gdn_gate_chain {
+    bool                is_beta;
+    const ggml_tensor * mm;
+    const ggml_tensor * add;     // beta: optional
+    const ggml_tensor * bias;    // the ADD's vector
+    const ggml_tensor * act;     // SIGMOID / SOFTPLUS
+    const ggml_tensor * mul;     // gate only
+    const ggml_tensor * a;
+    int                 last;
+};
+
+static bool ggml_cuda_gdn_gate_chain_parse(const ggml_cgraph * cgraph, int j, const ggml_tensor * x, int64_t K,
+                                           int64_t H, ggml_cuda_gdn_gate_chain & c) {
+    c = {};
+    const ggml_tensor * mm = cgraph->nodes[j];
+    if (mm->op != GGML_OP_MUL_MAT || mm->src[1] != x || !ggml_cuda_gdn_gates_w(mm->src[0], K, H) ||
+            mm->type != GGML_TYPE_F32) {
+        return false;
+    }
+    c.mm = mm;
+    const ggml_tensor * prev = mm;
+    int k = ggml_cuda_next_compute(cgraph, j);
+    if (k < 0) {
+        return false;
+    }
+    if (cgraph->nodes[k]->op == GGML_OP_ADD) {
+        c.add  = cgraph->nodes[k];
+        c.bias = ggml_cuda_other_src(c.add, prev);
+        if (!ggml_cuda_gdn_gates_vec(c.bias, H)) {
+            return false;
+        }
+        prev = c.add;
+        k = ggml_cuda_next_compute(cgraph, k);
+        if (k < 0) {
+            return false;
+        }
+    }
+    const ggml_tensor * u = cgraph->nodes[k];
+    if (u->op != GGML_OP_UNARY || ggml_cuda_strip_views(u->src[0]) != prev) {
+        return false;
+    }
+    c.act = u;
+    if (ggml_get_unary_op(u) == GGML_UNARY_OP_SIGMOID) {
+        c.is_beta = true;
+        c.last    = k;
+        return ggml_cuda_gdn_gates_vec(u, H);
+    }
+    if (ggml_get_unary_op(u) != GGML_UNARY_OP_SOFTPLUS || !c.add) {
+        return false;
+    }
+    k = ggml_cuda_next_compute(cgraph, k);
+    if (k < 0 || cgraph->nodes[k]->op != GGML_OP_MUL) {
+        return false;
+    }
+    c.mul  = cgraph->nodes[k];
+    c.a    = ggml_cuda_other_src(c.mul, u);
+    c.last = k;
+    return ggml_cuda_gdn_gates_vec(c.a, H) && ggml_cuda_gdn_gates_vec(c.mul, H);
+}
+
+// both gate chains back to back from the MUL_MAT at i (either order); the index of the last matched node, 0 if none
+static int ggml_cuda_gdn_gates_match(const ggml_cgraph * cgraph, int i, ggml_cuda_gdn_gates & p) {
+    const ggml_tensor * m0 = cgraph->nodes[i];
+    if (m0->op != GGML_OP_MUL_MAT) {
+        return 0;
+    }
+    const ggml_tensor * x = m0->src[1];
+    const int64_t K = m0->src[0]->ne[0];
+    const int64_t H = m0->src[0]->ne[1];
+    if (K % 8 != 0 || H < 1 || m0->src[0]->type != GGML_TYPE_F16 || x->type != GGML_TYPE_F32 ||
+            ggml_nelements(x) != K || !ggml_is_contiguous(x) || ((uintptr_t) x->data) % 16 != 0) {
+        return 0;
+    }
+    ggml_cuda_gdn_gate_chain c0, c1;
+    if (!ggml_cuda_gdn_gate_chain_parse(cgraph, i, x, K, H, c0)) {
+        return 0;
+    }
+    const int j = ggml_cuda_next_compute(cgraph, c0.last);
+    if (j < 0 || !ggml_cuda_gdn_gate_chain_parse(cgraph, j, x, K, H, c1) || c0.is_beta == c1.is_beta) {
+        return 0;
+    }
+    const ggml_cuda_gdn_gate_chain & cb = c0.is_beta ? c0 : c1;
+    const ggml_cuda_gdn_gate_chain & cg = c0.is_beta ? c1 : c0;
+    const int last = c1.last;
+    // the intermediates have no reader outside the matched nodes, and none is a graph output
+    const ggml_tensor * mid[5];
+    int nmid = 0;
+    mid[nmid++] = cb.mm;
+    if (cb.add) {
+        mid[nmid++] = cb.add;
+    }
+    mid[nmid++] = cg.mm;
+    mid[nmid++] = cg.add;
+    mid[nmid++] = cg.act;
+    for (int m = 0; m < nmid; ++m) {
+        if (mid[m]->flags & GGML_TENSOR_FLAG_OUTPUT) {
+            return 0;
+        }
+    }
+    for (int k = i; k <= last; ++k) {
+        const ggml_tensor * n = cgraph->nodes[k];
+        if (ggml_cuda_is_view_or_noop(n) && (n->flags & GGML_TENSOR_FLAG_OUTPUT) &&
+                std::find(mid, mid + nmid, ggml_cuda_strip_views(n)) != mid + nmid) {
+            return 0;
+        }
+    }
+    if (!ggml_cuda_only_inside_readers(cgraph, mid, nmid, (const ggml_tensor * const *) cgraph->nodes + i, last - i + 1)) {
+        return 0;
+    }
+    // the outputs may not overlap what the kernel reads (the allocator can reuse a dead input's buffer)
+    auto overlap = [](const ggml_tensor * u, const ggml_tensor * v) {
+        const char * a0 = (const char *) u->data, * a1 = a0 + ggml_nbytes(u);
+        const char * b0 = (const char *) v->data, * b1 = b0 + ggml_nbytes(v);
+        return a0 < b1 && b0 < a1;
+    };
