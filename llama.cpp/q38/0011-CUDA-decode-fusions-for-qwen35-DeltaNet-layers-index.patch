+// readers per tensor of the graph being evaluated: for every compute node, each distinct root (view_src, else the
+// tensor) among its sources counts once. Built lazily once per evaluation (ggml_cuda_reader_gen), so the fusion checks
+// for "no reader outside the matched nodes" cost O(matched nodes) instead of a scan of the whole graph each.
+static uint64_t ggml_cuda_reader_gen = 0;
+
+static const ggml_tensor * ggml_cuda_root(const ggml_tensor * t) {
+    return t->view_src ? t->view_src : t;
+}
+
+static int ggml_cuda_distinct_roots(const ggml_tensor * n, const ggml_tensor * out[GGML_MAX_SRC]) {
+    int k = 0;
+    for (int s = 0; s < GGML_MAX_SRC; ++s) {
+        if (!n->src[s]) {
+            continue;
+        }
+        const ggml_tensor * r = ggml_cuda_root(n->src[s]);
+        if (std::find(out, out + k, r) == out + k) {
+            out[k++] = r;
+        }
+    }
+    return k;
+}
+
+static int ggml_cuda_reader_count(const ggml_cgraph * cgraph, const ggml_tensor * t) {
+    static thread_local struct {
+        uint64_t gen = UINT64_MAX;
+        const ggml_cgraph * g = nullptr;
+        std::unordered_map<const ggml_tensor *, int> cnt;
+    } ix;
+    if (ix.gen != ggml_cuda_reader_gen || ix.g != cgraph) {
+        ix.gen = ggml_cuda_reader_gen;
+        ix.g   = cgraph;
+        ix.cnt.clear();
+        ix.cnt.reserve(2 * cgraph->n_nodes);
+        const ggml_tensor * r[GGML_MAX_SRC];
+        for (int i = 0; i < cgraph->n_nodes; ++i) {
+            const ggml_tensor * n = cgraph->nodes[i];
+            if (ggml_cuda_is_view_or_noop(n)) {
+                continue;
+            }
+            const int k = ggml_cuda_distinct_roots(n, r);
+            for (int j = 0; j < k; ++j) {
+                ix.cnt[r[j]]++;
+            }
+        }
+    }
+    const auto it = ix.cnt.find(ggml_cuda_root(t));
+    return it == ix.cnt.end() ? 0 : it->second;
+}
