+        nodes[2 * t + 1] = sn;
+    }
+    if (eps[0] != eps[1] || sc[0] != sc[1] || !ggml_are_same_stride(raw[0], raw[1]) || raw[0]->ne[0] != gdn->src[2]->ne[0]) {
+        return false;
+    }
+    {
+        const ggml_tensor * inside[5] = { gdn, nodes[0], nodes[1], nodes[2], nodes[3] };
+        if (!ggml_cuda_only_inside_readers(cgraph, nodes, 4, inside, 5)) {
