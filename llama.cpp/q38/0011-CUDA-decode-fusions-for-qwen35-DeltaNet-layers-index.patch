+// q / k of a gated_delta_net (decode, state gathered: ggml_cuda_gdn_state_gather) that are scale(rms_norm(x, eps), s)
+// of views x of one tensor, with no other reader: the kernel reads x and normalizes itself (g gets the raw pointers and
+// eps / s; nodes[] the four skipped nodes). False if not.
+static bool ggml_cuda_gdn_l2(const ggml_cgraph * cgraph, const ggml_tensor * gdn, ggml_cuda_gated_delta_net_state_gather & g,
+                             const ggml_tensor * nodes[4]) {
+    static const bool off = ggml_cuda_env_flag("GGML_CUDA_DISABLE_GDN_L2");
+    if (off) {
+        return false;
+    }
+    const ggml_tensor * raw[2];
+    float eps[2], sc[2];
+    for (int t = 0; t < 2; ++t) {
+        const ggml_tensor * sn = gdn->src[t];
+        if (!sn || sn->op != GGML_OP_SCALE || (sn->flags & GGML_TENSOR_FLAG_OUTPUT)) {
+            return false;
+        }
+        float b;
+        memcpy(&sc[t], (const float *) sn->op_params + 0, sizeof(float));
+        memcpy(&b,     (const float *) sn->op_params + 1, sizeof(float));
+        const ggml_tensor * rn = sn->src[0];
