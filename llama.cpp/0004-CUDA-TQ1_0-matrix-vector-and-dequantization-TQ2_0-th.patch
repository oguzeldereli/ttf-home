+template<typename dst_t>
+static __global__ void dequantize_block_tq1_0(const void * __restrict__ vx, dst_t * __restrict__ yy) {
+
+    const int64_t i = blockIdx.x;
+    const block_tq1_0 * x = (const block_tq1_0 *) vx;
+    const int e = threadIdx.x;     // the element, 0..255 (layout: vec_dot_tq1_0_q8_1)
+
+    int n, b;
+    if (e < 160) {
+        n = e / 32;          b = x[i].qs[e % 32];
+    } else if (e < 240) {
+        n = (e - 160) / 16;  b = x[i].qs[32 + (e - 160) % 16];
+    } else {
+        n = (e - 240) / 4;   b = x[i].qh[(e - 240) % 4];
+    }
+    const uint32_t pow3[5] = {1, 3, 9, 27, 81};
+    const uint32_t q = ((uint32_t) b * pow3[n]) & 0xFF;
+    yy[i*QK_K + e] = __half2float(x[i].d) * ((int) ((q * 3) >> 8) - 1);
+}
