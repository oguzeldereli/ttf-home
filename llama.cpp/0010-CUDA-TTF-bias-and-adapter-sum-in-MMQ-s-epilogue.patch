From 3e00ffcef1133164b243be66b0e71f4a312753df Mon Sep 17 00:00:00 2001
From: Ozgur Guzeldereli <ozgur@guzeldereli.com>
Date: Mon, 26 Oct 2026 06:46:17 +0000
Subject: [PATCH 10/10] CUDA: TTF bias and adapter sum in MMQ's epilogue

The graph computes the adapter before the main product (ggml_add(u, main)), so the batched product can add the
bias row vector and the adapter output where each tile is written once (the stream-k fixup adds the earlier
partials after). 27B prefill 682 -> 708 tok/s on an RTX 4080 laptop. Not bit-identical (fp32 add order); the
NLL moves within its noise (27B ladder 2.409259 -> 2.409343; CPU unchanged).
---
 ggml/src/ggml-cuda/common.cuh   |  1 +
 ggml/src/ggml-cuda/ggml-cuda.cu | 30 ++++++++++++++++--
 ggml/src/ggml-cuda/mmq.cu       | 10 ++++--
 ggml/src/ggml-cuda/mmq.cuh      | 55 ++++++++++++++++++++++++---------
 src/llama-graph.cpp             |  3 +-
 5 files changed, 78 insertions(+), 21 deletions(-)

diff --git a/ggml/src/ggml-cuda/common.cuh b/ggml/src/ggml-cuda/common.cuh
index 18fc12f5d..a78c0c390 100644
--- a/ggml/src/ggml-cuda/common.cuh
+++ b/ggml/src/ggml-cuda/common.cuh
@@ -1519,6 +1519,7 @@ struct ggml_cuda_mm_fusion_args_host {
     const ggml_tensor * x_bias = nullptr;
     const ggml_tensor * y_scale = nullptr;   // TTF: src1 * y_scale + y_shift per input channel, in the quantiser
     const ggml_tensor * y_shift = nullptr;
+    const ggml_tensor * x_add = nullptr;     // TTF: a tensor of dst's layout added in MMQ's epilogue (x_bias: a row vector there)
     const ggml_tensor * gate = nullptr;
     const ggml_tensor * gate_bias = nullptr;
     ggml_glu_op glu_op;
diff --git a/ggml/src/ggml-cuda/ggml-cuda.cu b/ggml/src/ggml-cuda/ggml-cuda.cu
index dcbac7bc7..10f8c0d9f 100644
--- a/ggml/src/ggml-cuda/ggml-cuda.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda.cu
@@ -4014,8 +4014,34 @@ static int ggml_cuda_try_fuse(ggml_backend_cuda_context * cuda_ctx, ggml_cgraph
                 ggml_cuda_mm_fusion_args_host fusion_data{};
                 fusion_data.y_scale = c;
                 fusion_data.y_shift = m;
-                ggml_cuda_mul_mat_q(*cuda_ctx, w, x, nullptr, mm, &fusion_data);
-                return k;
+                // and the epilogue: + b (a row vector), then + u (dst's layout: the adapter's output, computed earlier,
+                // since the graph puts it first), as long as each intermediate has no other use
+                ggml_tensor * dst = mm;
+                int n = k;
+                auto next_add = [&](const ggml_tensor * prev) -> const ggml_tensor * {
+                    if (i + n + 1 >= cgraph->n_nodes || !ggml_node_has_n_uses(cgraph, i + n, 1)) {
+                        return nullptr;
+                    }
+                    const ggml_tensor * a = cgraph->nodes[i + n + 1];
+                    if (a->op != GGML_OP_ADD || (a->flags & GGML_TENSOR_FLAG_COMPUTE) == 0 || a->type != GGML_TYPE_F32 ||
+                        !ggml_are_same_shape(a, prev)) {
+                        return nullptr;
+                    }
+                    return a->src[0] == prev ? a->src[1] : (a->src[1] == prev ? a->src[0] : nullptr);
+                };
+                const bool plain = ggml_is_contiguous(mm) && mm->ne[2] == 1 && mm->ne[3] == 1;
+                const ggml_tensor * o = plain ? next_add(dst) : nullptr;
+                if (o && o->type == GGML_TYPE_F32 && ggml_is_contiguous(o) && ggml_nelements(o) == mm->ne[0]) {
+                    fusion_data.x_bias = o;
+                    dst = cgraph->nodes[i + ++n];
+                    o = next_add(dst);
+                }
+                if (o && o->type == GGML_TYPE_F32 && ggml_is_contiguous(o) && ggml_are_same_shape(o, mm)) {
+                    fusion_data.x_add = o;
+                    dst = cgraph->nodes[i + ++n];
+                }
+                ggml_cuda_mul_mat_q(*cuda_ctx, w, x, nullptr, dst, &fusion_data);   // writes dst = the last add
+                return n;
             }
             if (ok) {
                 ggml_cuda_mm_fusion_args_host fusion_data{};
